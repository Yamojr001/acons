APP_NAME="EduSaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos
APP_PLATFORM_DOMAIN=localhost

# ─── SECURITY ──────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
BCRYPT_ROUNDS=12

LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_DECAY_MINUTES=15

# ─── DATABASE (MySQL 8.0) ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edusaas
DB_USERNAME=edusaas_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ─── CACHE & QUEUE ─────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=database
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── MAIL ──────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── STRIPE ────────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_XXXX
STRIPE_SECRET_KEY=sk_test_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX
STRIPE_CURRENCY=ngn

# ─── PAYSTACK ──────────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_test_XXXX
PAYSTACK_SECRET_KEY=sk_test_XXXX
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_MERCHANT_EMAIL=payments@yourdomain.com

# ─── MONNIFY ───────────────────────────────────────────────────────────────
MONNIFY_API_KEY=MK_TEST_XXXX
MONNIFY_SECRET_KEY=XXXX
MONNIFY_CONTRACT_CODE=XXXX
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_CURRENCY=NGN

# ─── FILE STORAGE ──────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# Optional Cloudflare R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=edusaas-storage
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── LOGGING ───────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=debug

VITE_APP_NAME="${APP_NAME}"
VITE_APP_ENV="${APP_ENV}"
